{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "example-pi-session",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },

  // ── Managed by `actors generate` ──────────────────────────────────────────
  // One Durable Object class (ActorHost) hosts every actor type, so adding or
  // removing actors never needs a new migration. Everything else here is yours.
  "main": ".actors/entry.ts",
  "durable_objects": {
    "bindings": [
      {
        "name": "ACTORS",
        "class_name": "ActorHost"
      },
      {
        "name": "SESSION",
        "class_name": "Session"
      }
    ]
  },
  "migrations": [
    {
      "tag": "actors-v1",
      "new_sqlite_classes": [
        "ActorHost"
      ]
    },
    {
      "tag": "actors-do-Session",
      "new_sqlite_classes": [
        "Session"
      ]
    }
  ],
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  }
}
