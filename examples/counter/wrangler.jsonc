{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "example-counter",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },

  // ── Managed by `actors generate` ──────────────────────────────────────────
  // One Durable Object class (ActorHost) hosts every actor type, so adding or
  // removing actors never needs a new migration. Everything else here is yours.
  "main": ".actors/entry.ts",
  "durable_objects": { "bindings": [{ "name": "ACTORS", "class_name": "ActorHost" }] },
  "migrations": [{ "tag": "actors-v1", "new_sqlite_classes": ["ActorHost"] }]
}
